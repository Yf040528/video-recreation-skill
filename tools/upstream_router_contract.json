      "FAILED",
      "PENDING"
    ],
    "success_outputs": "array of {type, uri, mime_type?, metadata?}",
    "failure_error": "{code, message, retryable}"
  },
  "integration_note": "Map this logical contract to any generation backend. The reference adapter targets the FrameFlow public API (executor/router_adapter_yimiagent.py)."
}